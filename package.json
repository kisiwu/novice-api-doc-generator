{
  "name": "novice-api-doc-generator",
  "private": true,
  "version": "1.2.6",
  "description": "Monorepo for API documentation generator for @novice1",
  "main": "lib/index.js",
  "homepage": "https://github.com/kisiwu/novice-api-doc-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/novice-api-doc-generator.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rimraf node_modules lib docs coverage && rimraf node_modules",
    "clean:build": "pnpm -r exec rimraf lib",
    "clean:deps": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "clean:coverage": "pnpm -r exec rimraf coverage",
    "doc": "pnpm --filter \"./packages/*\" -r doc",
    "format": "pnpm --filter \"./packages/*\" -r format",
    "format:check": "pnpm --filter \"./packages/*\" -r format:check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test",
    "release:build": "pnpm --filter \"./packages/*\" -r build",
    "release:test": "pnpm --filter \"./packages/*\" -r test",
    "release:version": "pnpm --filter \"./packages/*\" -r exec npm version",
    "release:publish": "pnpm --filter \"./packages/*\" -r publish --access public",
    "version:patch": "pnpm --filter \"./packages/*\" -r exec npm version patch",
    "version:minor": "pnpm --filter \"./packages/*\" -r exec npm version minor",
    "version:major": "pnpm --filter \"./packages/*\" -r exec npm version major"
  },
  "keywords": [
    "openapi",
    "postman",
    "swagger",
    "json",
    "joi",
    "zod",
    "valibot",
    "arktype"
  ],
  "author": "demingongo",
  "contributors": [
    "sbolingo"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.13.0",
    "kaukau": "^5.1.0-alpha.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.71.2"
  }
}